# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration — never prefix these with NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Site-wide password gate (middleware.ts). Required for every environment,
# including local dev — the gate fails closed if this is unset. Use a
# throwaway value locally; the real value is set directly in Vercel and never
# needs to exist in this repo or in shell history.
SITE_ACCESS_PASSWORD=
