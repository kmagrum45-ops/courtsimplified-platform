# =========================================================
# COURTSIMPLIFIED - MASTER GITIGNORE
# =========================================================

# =========================================================
# DEPENDENCIES
# =========================================================

/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =========================================================
# TESTING / COVERAGE
# =========================================================

/coverage
/test-results/
/walkthrough-output/

# =========================================================
# NEXT.JS / BUILD OUTPUT
# =========================================================

/.next/
/out/
/build/

# =========================================================
# TYPESCRIPT
# =========================================================

*.tsbuildinfo
next-env.d.ts

# =========================================================
# ENVIRONMENT / SECRETS
# =========================================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =========================================================
# API KEYS / CREDENTIALS
# =========================================================

*credentials*.json
*secret*.json
*service-account*.json
*private-key*.json

# =========================================================
# SUPABASE / DATABASE EXPORTS
# =========================================================

supabase-export/
database-backups/
*.sql.bak

# =========================================================
# GENERATED FILES / REPORTS
# =========================================================

form-compatibility-report.json
project-file-map.txt

# Per-run output of the browser scenario quality harness. Timings and full
# page captures differ every run; the harness itself is committed.
scenario-quality-report.json

# =========================================================
# DOWNLOADS / GENERATED PDFS
# =========================================================

downloads/generated/
downloads/temp/
downloads/uploads/

# =========================================================
# USER FILES / CASE FILES
# =========================================================

user-uploads/
case-exports/
generated-documents/

# =========================================================
# LOGS / DEBUG
# =========================================================

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =========================================================
# SYSTEM FILES
# =========================================================

.DS_Store
Thumbs.db
*.pem

# =========================================================
# VERCEL
# =========================================================

.vercel

# =========================================================
# IDE
# =========================================================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# =========================================================
# PDF / TEMP PROCESSING
# =========================================================

tmp/
temp/
cache/
*.tmp

# =========================================================
# LOCAL AI / SCAN OUTPUTS
# =========================================================

scan-output/
field-maps/
pdf-debug/

# =========================================================
# SUPABASE CLI LOCAL STATE
# =========================================================
# Machine-local link cache (project ref, pooler URL, service versions).
# Migrations under supabase/migrations/ are NOT ignored.

supabase/.temp/

# =========================================================
# ENGINEERING SNAPSHOTS / GENERATED REGISTRIES
# =========================================================
# Output of `npm run snapshot` and the analysis tooling. The generators
# are committed; their output is not.
#
# _PROJECT_REGISTRY/PROJECT_DOCUMENTATION/ used to be tracked as an exception.
# Removed 2026-10-04: every file in it was a byte-identical (or staler) copy of
# the same file under docs/, which is the copy the scripts read and write.

_PROJECT_REGISTRY/
*.zip
buildlog.txt
create-dev-snapshot-current.txt
MADGE_CIRCULAR.json
UNUSED_EXPORTS.txt
DatabaseSchema.sql
PROJECT_HANDOFF_INFO.txt
PROJECT_FILE_LIST.txt

# =========================================================
# REPOMIX
# =========================================================

.repomix/
repomix-output.xml

# =========================================================
# DO NOT IGNORE PUBLIC ASSETS
# =========================================================

!public/
.env.diagnose
.env*

# Scratch space for source retrieval (antiword output, fetched HTML)
.tmp-src/

# Local audit sink. Every script, eval and fixture run writes its ai_call_log
# rows here instead of to the live database — see src/lib/audit/aiCallLog.ts.
# Rows describe calls and never hold what a user wrote, but they are not content
# either, and a fixture run produces dozens.
.ai-call-log.jsonl

# Story review outputs: the real report is published to the story-review-reports branch.
scripts/verification/storyReview/REPORT*.md
scripts/verification/storyReview/results*.json
/rules-diff.md
/forms-check-report.md
/forms-probe.json
/forms-probe-report.md

# Law exam run output (published to the law-exam-reports branch by its workflow).
/law-exam-report.md
/law-exam-report.json
/law-exam.log
