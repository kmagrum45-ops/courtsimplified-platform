<!-- Tabs Deep Linking Script -->
<script>
    // Deep linking - load tab on refresh
    let url = location.href.replace(/\/$/, '');
    if (location.hash) {
      const hash = url.split('#');
      const currentTab = document.querySelector('#ex1 a[href="#' + hash[1] + '"]');
      if (currentTab) {
          const curTab = new bootstrap.Tab(currentTab);
          curTab.show();
      }
      url = location.href.replace(/\/#/, '#');
      history.replaceState(null, null, url);
      setTimeout(() => {
        window.scrollTo(0, 0);
      }, 400);
    }

    // Change URL based on selected tab
    const selectableTabList = [].slice.call(document.querySelectorAll('a[data-mdb-toggle="tab"]'));
    selectableTabList.forEach((selectableTab) => {
      const selTab = new bootstrap.Tab(selectableTab);
      selectableTab.addEventListener('click', function () {
        var newUrl;
        const hash = selectableTab.getAttribute('href');
        if (hash == '#ex1-tabs-1') {
          newUrl = url.split('#')[0];
        } else {
          newUrl = url.split('#')[0] + hash;
        }
        history.replaceState(null, null, url);
      });
    });
</script>

