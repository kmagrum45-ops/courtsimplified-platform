<div class="metadata">
    <div class="info" >
        <div class="subinfo">
            <h3>
                <span class="title"><a target="_parent" href="/scc-csc/scc-csc/en/item/4627/index.do?q=%22Hunter+v.+Southam%22">R. v. Kang-Brown</a></span>
                        - <span class="citation">2008 SCC 18</span>
                    - <span class="report-citation">[2008] 1 SCR 456</span>
                - <span class="publicationDate">2008-04-25</span>
            </h3>
            <div class="subMetadata">
                <span>Supreme Court Judgments</span>
