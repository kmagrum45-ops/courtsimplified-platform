    <td width="342" valign="top" style="width:256.5pt;padding:2.9pt 2.9pt 2.9pt 2.9pt"><p class="MsoNormal"><b><span style="font-variant:small-caps">Citation:</span></b> Pintea <i>v.</i> Johns, 2017 SCC 23, [2017] 1 S.C.R. 470</p></td>
    <td width="296" valign="top" style="width:222.3pt;padding:2.9pt 2.9pt 2.9pt 2.9pt"><p class="MsoNormal" style="margin-left:15.1pt"><b><span style="font-variant:
  small-caps">Appeal heard:</span></b> April 18, 2017</p> <p class="MsoNormal" style="margin-left:19.6pt;text-indent:-4.5pt"><b><span style="font-variant:small-caps">Judgment rendered:</span></b> April 18, 2017</p> <p class="MsoNormal" style="margin-left:15.1pt"><b><span style="font-variant:
  small-caps">Docket:</span></b> 37109</p></td>
   </tr>
