<div class="documentcontent"><div class="WordSection1">
 <p class="MsoHeader"><w:ptab alignment="CENTER" relativeto="MARGIN" leader="NONE"></w:ptab> &nbsp;<img width="82" height="86" src="/scc-csc/scc-csc/en/16589/1771348/res.do" />&nbsp; <w:ptab alignment="RIGHT" relativeto="MARGIN" leader="NONE"></w:ptab> &nbsp;</p>
 <p class="MsoHeader">&nbsp;</p>
 <p class="MsoNormal" align="center" style="text-align:center"><b>SUPREME COURT OF CANADA</b></p>
 <p class="MsoNormal">&nbsp;</p>
 <table class="MsoTableGrid" border="0" cellspacing="0" cellpadding="0" width="0" style="border-collapse:collapse;border:none">
