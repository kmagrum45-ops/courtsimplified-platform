}

@media only screen and ((max-device-width: 545px) or (max-width: 545px)) {
    #decisia-footer .decisia-lexum a, #decisia-footer .qweri-lexum a {
	    top: 75px;
	}
	
	#decisia-footer {
	    padding-bottom: 81px;
	}
}
</style>

