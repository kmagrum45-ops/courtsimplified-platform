                <a href='javascript:void(0)' class='expand-result' title='Collapse result'></a>
        </div> 
    </div> 
    </div> 
</li>
    <li class="odd list-item-expanded">
<div class="number">
    <span class="digits">3.</span>
</div>
<div class="metadata">
    <div class="info" >
        <div class="subinfo">
            <h3>
                <span class="title"><a target="_parent" href="/scc-csc/scc-csc/en/item/18909/index.do?q=%22D.B.S.+v.+S.R.G.%22">Colucci v. Colucci</a></span>
                        - <span class="citation">2021 SCC 24</span>
                    - <span class="report-citation">[2021] 2 SCR 3</span>
                - <span class="publicationDate">2021-06-04</span>
            </h3>
