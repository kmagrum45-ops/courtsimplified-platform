</div>
<div class="metadata">
    <div class="info" >
        <div class="subinfo">
            <h3>
                <span class="title"><a target="_parent" href="/coa/coa/en/item/18506/index.do?q=%222014+ONCA+194%22">Zeifman Partners Inc. v. Aiello</a></span>
                        - <span class="citation">2020 ONCA 33</span>
                - <span class="publicationDate">2020-01-21</span>
            </h3>
            <div class="subMetadata">
                <span>Decisions of the Court of Appeal</span>
