<div class="documentcontent"> 
  <div class="Section1"> 
   <div> 
    <table cellspacing="0" cellpadding="0" hspace="0" vspace="0" width="74" height="77"> 
     <tbody>
      <tr> 
       <td valign="top" align="left" height="77" style="padding-top:0cm;padding-right:
  0cm;padding-bottom:0cm;padding-left:0cm"> <p class="MsoNormal"><img width="74" height="77" src="/scc-csc/scc-csc/en/4629/1770061/res.do" /></p> </td> 
      </tr> 
