 <p class="MsoHeader"><w:ptab alignment="CENTER" relativeto="MARGIN" leader="NONE"></w:ptab> &nbsp;<img width="82" height="86" src="/scc-csc/scc-csc/en/15471/1765258/res.do" />&nbsp; <w:ptab alignment="RIGHT" relativeto="MARGIN" leader="NONE"></w:ptab></p>
 <p class="MsoHeader">&nbsp;</p>
