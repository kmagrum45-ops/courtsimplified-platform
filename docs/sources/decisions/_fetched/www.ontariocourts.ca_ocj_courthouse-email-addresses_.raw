    font-weight: 600;
    color: #666666;
    line-height: 1.4rem;
    width: 100% !important;
    display: flex;
    align-items: flex-start;
}

.menu_container ul li:hover {
    background-color: #e3e3e3;
}

#SearchOCJ {
    float: left;
    width: 79%;
    border-radius: 5px 0 0 5px;
    height: 30px;
}

#SearchOCJButton {
    border-radius: 0 5px 5px 0;
}

