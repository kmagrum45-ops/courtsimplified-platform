     <td valign="top" align="left" height="77" style="padding-top:0cm;padding-right:
  0cm;padding-bottom:0cm;padding-left:0cm"><p class="MsoNormal"><img width="74" height="77" src="/scc-csc/scc-csc/en/7/1777292/res.do" /></p></td>
