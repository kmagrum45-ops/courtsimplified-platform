      <td width="414" valign="top" style="width:310.5pt;padding:0cm 0cm 0cm 0cm"> <p class="MsoNormal" style="line-height:6.0pt"><span lang="FR-CA">&nbsp;</span></p> <p class="MsoNormal"><b><span lang="FR-CA" style="text-transform:uppercase">Citation:</span></b><span lang="FR-CA" style="text-transform:uppercase"> </span><span lang="FR-CA">&nbsp;Hydro‑Québec <i>v. </i>Syndicat des employé‑e‑s de techniques professionnelles et de bureau d’Hydro‑Québec, section locale 2000 (SCFP‑FTQ), </span></p> <p class="MsoNormal" style="margin-bottom:2.9pt"><span lang="EN-GB">[2008] 2 S.C.R. 561, 2008 SCC 43</span></p> </td> 
      <td width="210" valign="top" style="width:157.5pt;padding:0cm 0cm 0cm 0cm"> <p class="MsoNormal" style="line-height:6.0pt"><span lang="EN-GB">&nbsp;</span></p> <p class="MsoNormal" style="margin-left:31.5pt"><b><span lang="EN-GB" style="text-transform:uppercase">Date:</span></b><span lang="EN-GB">&nbsp;&nbsp;20080717</span></p> <p class="MsoNormal" style="margin-top:0cm;margin-right:0cm;margin-bottom:2.9pt;
  margin-left:31.5pt"><b><span lang="EN-GB" style="text-transform:uppercase">Docket:</span></b><span lang="EN-GB">&nbsp;&nbsp;31395</span></p> </td> 
     </tr> 
