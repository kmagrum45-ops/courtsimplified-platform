<div class="documentcontent"><div class="WordSection1">
 <p class="MsoNormal"><w:ptab alignment="CENTER" relativeto="MARGIN" leader="NONE"></w:ptab> &nbsp;<img width="82" height="86" src="/scc-csc/scc-csc/en/18078/1756532/res.do" />&nbsp; <w:ptab alignment="RIGHT" relativeto="MARGIN" leader="NONE"></w:ptab></p>
 <p class="MsoNormal">&nbsp;</p>
 <p class="MsoNormal" align="center" style="text-align:center"><b>SUPREME COURT OF CANADA</b></p>
 <p class="MsoNormal">&nbsp;</p>
 <table class="TableGrid3" border="0" cellspacing="0" cellpadding="0" width="0" style="border-collapse:collapse;border:none">
  <tbody>
   <tr style="page-break-inside:avoid">
    <td width="366" valign="top" style="width:274.5pt;padding:2.9pt 2.9pt 2.9pt 2.9pt"><p class="MsoNormal"><b><span style="font-variant:small-caps">Citation:</span></b> Canada (Minister of Citizenship and Immigration) <i>v.</i> Vavilov, 2019 SCC 65, [2019] 4 S.C.R. 653</p></td>
    <td width="272" valign="top" style="width:204.3pt;padding:2.9pt 2.9pt 2.9pt 2.9pt"><p class="MsoNormal"><b><span style="font-variant:small-caps;color:black">Appeal Heard: </span></b><span style="color:black">December 4, 5, 6, 2018</span></p> <p class="MsoNormal"><b><span style="font-variant:small-caps;color:black">Judgment Rendered</span></b><b><span style="color:black">: </span></b><span style="color:black">December 19, 2019</span></p> <p class="MsoNormal"><b><span style="font-variant:small-caps">Docket:</span></b> 37748</p></td>
   </tr>
  </tbody>
 </table>
 <p class="MsoNormal">&nbsp;</p>
 <p class="MsoNormal"><b><span style="font-variant:small-caps">Between:</span></b></p>
 <p class="MsoNormal" align="center" style="text-align:center"><b>Minister of Citizenship and Immigration</b></p>
