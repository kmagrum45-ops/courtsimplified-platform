      <td width="354" valign="top" style="width:265.5pt;padding:2.9pt 2.9pt 2.9pt 2.9pt"> <p class="MsoNormal"><b><span style="font-variant:small-caps">Citation:</span></b> Rankin (Rankin’s Garage &amp; Sales) <i>v.</i> J.J., 2018 SCC 19, [2018] 1 S.C.R. 587</p> </td> 
      <td width="284" valign="top" style="width:213.3pt;padding:2.9pt 2.9pt 2.9pt 2.9pt"> <p class="MsoNormal"><b><span style="font-variant:small-caps">Appeal Heard: </span></b>October 5, 2017</p> <p class="MsoNormal"><b><span style="font-variant:small-caps">Judgment Rendered:</span></b> May 11, 2018</p> <p class="MsoNormal"><b><span style="font-variant:small-caps">Docket:</span></b> 37323</p> </td> 
