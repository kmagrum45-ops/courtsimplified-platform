                            <label id="decisia-advanced-search-show-fields" for="chkShowAdvanced" data-toggle="collapse" data-target="#decisia-advanced-search-additional-fields">
                                Show more fields&nbsp;<span class="decisia-icon icon-chevron-down"></span>
                            </label>
                        </div>

                        <input id="chkShowAdvanced" name="chkShowAdvanced" type="checkbox" />

                        <div class="clear-right"></div>
    <div class="decisia-content-row">
        <div class="label">
            <label for="decisia-content">Full text search</label>
        <button type="button" class="decisia-help-icon">
            <span class="decisia-icon icon-question-circle"></span>
            <span class="accessibility-only">Help</span>
        </button>
        <div class="decisia-help-tooltip">                Syntax: "", OR, AND, EXACT(), /p, /s, /n
</div>
        </div>
        <div class="input">
<input id="decisia-content" class="decisia-text" type="text" name="cont" value="&quot;Small Claims&quot; jurisdiction" />
        </div>
    </div>
    <div class="decisia-reference-row">
        <div class="label">
            <label for="decisia-reference-decisions">Case name, Neutral citation, Report, Case number</label>
        </div>
        <div class="input">
<input id="decisia-reference-decisions" class="decisia-text" type="text" name="ref" value=""/>
        </div>
    </div>
