</div>
<div class="metadata">
    <div class="info" >
        <div class="subinfo">
            <h3>
                <span class="title"><a target="_parent" href="/coa/coa/en/item/19835/index.do?q=Crown+Liability+and+Proceedings+Act+section+31+transition">R. v. Pavao</a></span>
                        - <span class="citation">2021 ONCA 527</span>
