    </div> 
    </div> 
</li>
    <li class="even list-item-expanded">
<div class="number">
    <span class="digits">20.</span>
</div>
<div class="metadata">
    <div class="info" >
        <div class="subinfo">
            <h3>
                <span class="title"><a target="_parent" href="/coa/coa/en/item/10357/index.do?q=Crown+Liability+and+Proceedings+Act+section+31+transition">Indalex Limited (Re)</a></span>
