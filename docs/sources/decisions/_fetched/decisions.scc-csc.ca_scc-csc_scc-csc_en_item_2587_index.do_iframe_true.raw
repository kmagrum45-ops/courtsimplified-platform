    <tbody>
     <tr> 
      <td width="297" valign="top" style="width:222.9pt;border:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt"> <p class="Para"><span lang="EN-CA" style="font-size:10.0pt">1. <u>Pecuniary Loss</u></span></p> </td> 
      <td width="297" valign="top" style="width:222.9pt;border:solid windowtext 1.0pt;
