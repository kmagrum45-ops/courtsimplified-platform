     <tr> 
      <td width="297" valign="top" style="width:222.9pt;border:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt"> <p class="Para"><span lang="EN-CA">(b) <u>Prospective loss of earnings</u></span></p> </td> 
