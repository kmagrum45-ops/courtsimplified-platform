   <div id="ftn16"> 
    <p class="MsoFootnoteText"><a href="#_ftnref16" name="_ftn16" title=""><span class="MsoFootnoteReference"><span lang="FR-CA"><span class="MsoFootnoteReference"><span lang="FR-CA" style="font-size:12.0pt;font-family:Arial">[16]</span></span></span></span></a><span lang="FR-CA"> </span><span lang="EN-CA">[1968] S.C.R. 589.</span></p> 
   </div> 
   <div id="ftn17"> 
    <p class="Para"><a href="#_ftnref17" name="_ftn17" title=""><span class="MsoFootnoteReference"><span lang="FR-CA"><span class="MsoFootnoteReference"><span lang="FR-CA" style="font-size:12.0pt;font-family:Arial">[17]</span></span></span></span></a><span lang="FR-CA"> </span><span lang="EN-CA">(1962), 108 C.L.R. 541.</span></p> 
