<div class="documentcontent"><div class="WordSection1">
 <p class="MsoNormal" align="center" style="text-align:center"><w:ptab alignment="CENTER" relativeto="MARGIN" leader="NONE"></w:ptab> &nbsp;<img width="82" height="85" src="/scc-csc/scc-csc/en/18460/1843243/res.do" />&nbsp;<w:ptab alignment="RIGHT" relativeto="MARGIN" leader="NONE"></w:ptab></p>
 <p class="MsoNormal" align="center" style="text-align:center"><b>SUPREME COURT OF CANADA</b></p>
 <p class="MsoNormal">&nbsp;</p>
 <table class="TableGrid2" border="0" cellspacing="0" cellpadding="0" width="0" style="border-collapse:collapse;border:none">
