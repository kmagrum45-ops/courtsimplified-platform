					<div class="bd-highlight">
						<p class="">
							<!-- //////////////////////////////////////////////////////////////////// -->
							<!-- Modal Search label -->
							New search							<!-- End of Modal Search label -->
							<!-- //////////////////////////////////////////////////////////////////// -->
						</p>

						<!-- New Search group -->
						<div class="input-group rounded">

							<input id="searchontariocourtlocationsinmodal" name="searchontariocourtlocationsinmodal" type="search" class="form-control rounded OCJ-form-fields" placeholder="Enter city" aria-label="Search" aria-describedby="search-addon">

							<button id="btn-locationsinmodal" class="ontario-button ontario-button--primary OCJ-input-group-btn rounded OCJ-auto-width ms-1 reload-modal">
								<i class="fa-regular fa-magnifying-glass OCJ-fa-icons-24 text-white"></i>
							</button>

						</div>
						<!-- End of New Search group -->
						<!-- //////////////////////////////////////////////////////////////////// -->


						<!-- //////////////////////////////////////////////////////////////////// -->
						<!-- Search modal Data Functions -->
					<script>
						function autocomplete(inp, arr) {
						/*the autocomplete function takes two arguments,
						the text field element and an array of possible autocompleted values:*/
						var currentFocus;
						/*execute a function when someone writes in the text field:*/
						inp.addEventListener("input", function(e) {
							var a, b, i, val = this.value;
							/*close any already open lists of autocompleted values*/
							closeAllLists();
							if (!val) { return false;}
							currentFocus = -1;
							/*create a DIV element that will contain the items (values):*/
							a = document.createElement("DIV");
							a.setAttribute("id", this.id + "autocomplete-list");
							a.setAttribute("class", "autocomplete-items");
							/*append the DIV element as a child of the autocomplete container:*/
							this.parentNode.appendChild(a);
							/*for each item in the array...*/
							for (i = 0; i < arr.length; i++) {
								/*check if the item starts with the same letters as the text field value:*/
								if (arr[i].substr(0, val.length).toUpperCase() == val.toUpperCase()) {
								/*create a DIV element for each matching element:*/
								b = document.createElement("DIV");
								/*make the matching letters bold:*/
								b.innerHTML = "<strong>" + arr[i].substr(0, val.length) + "</strong>";
								b.innerHTML += arr[i].substr(val.length);
								/*insert a input field that will hold the current array item's value:*/
								b.innerHTML += "<input type='hidden' value='" + arr[i] + "'>";
								/*execute a function when someone clicks on the item value (DIV element):*/
								b.addEventListener("click", function(e) {
    /*insert the value for the autocomplete text field:*/
    inp.value = this.getElementsByTagName("input")[0].value;
   
    /*close the list of autocompleted values,
    (or any other open lists of autocompleted values:*/
    closeAllLists();
});

								a.appendChild(b);
								}
							}
						});
						/*execute a function presses a key on the keyboard:*/
						inp.addEventListener("keydown", function(e) {
							var x = document.getElementById(this.id + "autocomplete-list");
							if (x) x = x.getElementsByTagName("div");
							if (e.keyCode == 40) {
								/*If the arrow DOWN key is pressed,
								increase the currentFocus variable:*/
								currentFocus++;
								/*and and make the current item more visible:*/
								addActive(x);
							} else if (e.keyCode == 38) { //up
								/*If the arrow UP key is pressed,
								decrease the currentFocus variable:*/
								currentFocus--;
								/*and and make the current item more visible:*/
								addActive(x);
							} else if (e.keyCode == 13) {
								/*If the ENTER key is pressed, prevent the form from being submitted,*/
								e.preventDefault();
								if (currentFocus > -1) {
								/*and simulate a click on the "active" item:*/
								if (x) x[currentFocus].click();
								}
							}
						});
						function addActive(x) {
							/*a function to classify an item as "active":*/
							if (!x) return false;
							/*start by removing the "active" class on all items:*/
							removeActive(x);
							if (currentFocus >= x.length) currentFocus = 0;
							if (currentFocus < 0) currentFocus = (x.length - 1);
							/*add class "autocomplete-active":*/
							x[currentFocus].classList.add("autocomplete-active");
						}
						function removeActive(x) {
							/*a function to remove the "active" class from all autocomplete items:*/
							for (var i = 0; i < x.length; i++) {
							x[i].classList.remove("autocomplete-active");
							}
						}
						function closeAllLists(elmnt) {
							/*close all autocomplete lists in the document,
							except the one passed as an argument:*/
							var x = document.getElementsByClassName("autocomplete-items");
							for (var i = 0; i < x.length; i++) {
							if (elmnt != x[i] && elmnt != inp) {
								x[i].parentNode.removeChild(x[i]);
							}
							}
						}
						/*execute a function when someone clicks in the document:*/
						document.addEventListener("click", function (e) {
							closeAllLists(e.target);
						});
						}

						/*An array containing all the court location names in the Ontario:*/
						var ontariocourtlocationsmodal = ["Alexandria","Atikokan (Fort Frances)","Bancroft","Blind River","Brantford","Barrie","Bracebridge","Brighton","Bearskin Lake (Kenora)","Bradford (Barrie)","Brockville","Belleville","Brampton","Big Trout Lake (Dryden)","Cat Lake (Kenora)","Chatham","Collingwood (Barrie)","Cayuga","Cobourg","Cornwall","Chapleau (Timmins)","Cochrane","Deer Lake (Kenora)","Dryden","Elliot Lake","Espanola (Sudbury)","Fort Albany (Timmins)","Fort Frances","Fort Severn (Kenora)","Fort Erie (Welland)","Gogama (Timmins)","Guelph","Goderich","Gore Bay","Haileybury","Hearst (Cochrane)","Huntsville (Bracebridge)","Hamilton &#8211; John Sopinka","Hornepayne (Cochrane)","Ignace (Dryden)","Kapuskasing (Cochrane)","Kemptville","Kingston","Kasabonika (Dryden)","Kenora","Killaloe (County of Renfrew)","Kirkland Lake","Kashechewan (Cochrane)","Kingfisher (Kenora)","Kitchener","Keewaywin (Kenora)","L&#8217;Orignal","London","Lac Seul (Dryden)","Leamington (Windsor)","Lindsay","Midland (Barrie)","Morrisburg (Cornwall)","Milton (Halton)","Muskrat Dam (Kenora)","Minden (Lindsay)","Mattawa (North Bay)","Moosonee (Timmins)","Napanee","North Spirit Lake (Kenora)","Newmarket","North Bay","Orillia","Ottawa","Orangeville","Oshawa &#8211; Durham","Owen Sound","Parry Sound","Perth","Picton","Peawanuck (Cochrane)","Peterborough","Pikangikum (Kenora)","Pembroke","Mishkeegogamang (Dryden)","Poplar Hill (Kenora)","Rainy River (Fort Frances)","Renfrew (County of Renfrew)","Red Lake (Dryden)","Sachigo Lake (Kenora)","Simcoe","Stratford","Sandy Lake (Kenora)","Sioux Lookout (Dryden)","Sturgeon Falls (North Bay)","Sarnia","Sudbury","Sault Ste. Marie","Smooth Rock Falls (Cochrane)","St. Catharines","Sundridge (Parry Sound)","Sharbot Lake (Kingston)","St. Thomas","Thunder Bay","Timmins","Walkerton","Weagamow Lake (Dryden)","Windsor","Woodstock","Wapekeka (Dryden)","Welland","Wunnumin Lake (Kenora)","Wawa","Wikwemikong (Gore Bay)","Attawapiskat (Cochrane)","Toronto 10 Armoury St.","Toronto – Regional Bail Centre","Hamilton"]

						/*initiate the autocomplete function on the "myInput" element, and pass along the countries array as possible autocomplete values:*/
						autocomplete(document.getElementById("searchontariocourtlocationsinmodal"), ontariocourtlocationsmodal);

					</script>

					<!-- End of Search modal Data Functions -->
					<!-- //////////////////////////////////////////////////////////////////// -->

				</div> <!-- end of search column -->
	</div>
</div>

