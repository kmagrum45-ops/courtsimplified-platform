								<br>
								<div class="collapse" id="CollapseSection1" style="">
									<div class="row">
										<div class="col-sm-12 col-md-12">
											<div class="row">
												<!-- Left Side -->
												<div class="col-md-12 pe-2">
																											<div class="row pb-2">
															<div class="col-lg-12">
																<p></p>
																<p>For&nbsp;details about virtual criminal case management court&nbsp;appearances, see&nbsp;<a href="https://www.ontariocourts.ca/ocj/notices/criminal-case-management-appearances/" data-wpel-link="internal">Criminal Case Management&nbsp;Appearances</a></p>
															</div>
															<div class="col-lg-12">
																<p><strong>Courtroom matter</strong></p>
															</div>
															<div class="col-lg-12">
																<div class="form-check">
    <input class="form-check-input" type="radio" name="Hamiltoncourts" id="Hamiltoncourts1" value="1" checked/>
    <label class="form-check-label" for="Hamiltoncourts1"><strong>(Courtroom 204 ) </strong>Adult Criminal Case Management Court - All Day (Monday, Tuesday, Thursday)   Federal Matters (All Day) Wednesday   Domestic Matters / Unrepresented Accused (All Day) Friday   Peace Bonds/Withdrawals (All Day) Monday to Friday </label>
</div><div class="form-check">
    <input class="form-check-input" type="radio" name="Hamiltoncourts" id="Hamiltoncourts2" value="2"/>
    <label class="form-check-label" for="Hamiltoncourts2"><strong>(Courtroom 326 ) </strong>Overnight Arrests/Video Remand - All Day (Monday to Friday) </label>
</div><div class="form-check">
    <input class="form-check-input" type="radio" name="Hamiltoncourts" id="Hamiltoncourts3" value="3"/>
    <label class="form-check-label" for="Hamiltoncourts3"><strong>(Courtroom 300) </strong>Domestic – Friday morning   Youth – Friday afternoon   Peace Bonds/Withdrawals – All Day Friday </label>
</div>															</div>
														</div>
														<div class="row">
															<div class="col-lg-12">
																<p><strong>Courtroom number:  </strong><div class="desc" id="HamiltonCourts1" >204 </div><div class="desc" id="HamiltonCourts2" style="display: none;">326 </div><div class="desc" id="HamiltonCourts3" style="display: none;">300</div>																</p>
															</div>									 
														</div>

														<div class="row">
