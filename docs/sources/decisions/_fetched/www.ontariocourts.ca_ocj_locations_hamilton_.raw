				<div class="col-sm-12 col-md-4 ps-2 pe-2 pb-2">
					<div class="bd-highlight">
						<!--<img class="img-fluid wp-image-3391" src="https://uat.ontariocourts.ca/ocj/wp-content/uploads/2022/10/Barrie-Courthouse-map.jpg" srcset="" sizes="" alt="" width="303" height="88">-->
						<iframe width="303" height="90" style="border:0" loading="lazy" allowfullscreen src="https://www.google.com/maps/embed/v1/place?q=place_id:ChIJ27rF1YKbLIgRVTado9qsoI8&key=AIzaSyCjjmmHmUYrXBFGnS_GdpJQCaHZXjGgSUk&region=CA&language=en"></iframe>
					</div>
