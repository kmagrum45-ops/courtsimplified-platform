		<!-- Modal Search Location Details -->
		<script>
    $(document).ready(function() {
        $("input[name$='Hamiltoncourts']").click(function() {
            var option_num = $(this).val();

            $("div.desc").hide();
            $("span.desc").hide();
            $("#HamiltonCourts" + option_num).show(); // courtroom number 
            $("#tblHamiltonCourt" + option_num).show(); // schedule
            $("#zoomHamiltonCourts" + option_num).show(); // zoom
            $("#zoommeetingidHamiltonCourts" + option_num).show(); // meeting id
            $("#zoompasscodeHamiltonCourts" + option_num).show(); // meeting id
            $("#phoneHamiltonCourts" + option_num).show(); // phone
            $("#phonemeetingidHamiltonCourts" + option_num).show(); // meeting id
            $("#phonepasscodeHamiltonCourts" + option_num).show(); // meeting id
        });

        // Add the same functionality for plea courts
        $("input[name$='Hamiltonpleacourts']").click(function() {
            var option_num = $(this).val();

            $("div.plea_desc").hide();
            $("span.plea_desc").hide();
            $("#HamiltonPleaCourts" + option_num).show(); // courtroom number 
            $("#tblHamiltonPleaCourt" + option_num).show(); // schedule
            $("#zoomHamiltonPleaCourts" + option_num).show(); // zoom
            $("#zoommeetingidHamiltonPleaCourts" + option_num).show(); // meeting id
            $("#zoompasscodeHamiltonPleaCourts" + option_num).show(); // meeting id
            $("#phoneHamiltonPleaCourts" + option_num).show(); // phone
            $("#phonemeetingidHamiltonPleaCourts" + option_num).show(); // meeting id
            $("#phonepasscodeHamiltonPleaCourts" + option_num).show(); // meeting id
        });
    });
</script>
