            <h3>
                <span class="title"><a target="_parent" href="/coa/coa/en/item/10962/index.do?q=%22Jones+v.+Tsige%22">Jones v. Tsige</a></span>
                        - <span class="citation">2012 ONCA 32</span>
                - <span class="publicationDate">2012-01-18</span>
            </h3>
            <div class="subMetadata">
