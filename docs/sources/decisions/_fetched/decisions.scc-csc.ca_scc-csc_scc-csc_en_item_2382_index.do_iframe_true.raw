    <td width="414" valign="top" style="width:310.5pt;padding:0cm 0cm 0cm 0cm"><p class="MsoNormal" style="line-height:6.0pt"><span lang="EN-GB">&nbsp;</span></p> <p class="MsoNormal" style="margin-bottom:2.9pt"><b><span lang="EN-GB" style="text-transform:uppercase">Citation:</span></b><span lang="EN-GB" style="text-transform:uppercase">&nbsp; </span><span lang="EN-GB">Hill <i>v.</i> Hamilton‑Wentworth Regional Police Services Board</span>, [2007] 3 S.C.R. 129, 2007 SCC 41</p></td>
    <td width="210" valign="top" style="width:157.5pt;padding:0cm 0cm 0cm 0cm"><p class="MsoNormal" style="line-height:6.0pt">&nbsp;</p> <p class="MsoNormal" style="margin-left:31.5pt"><b><span style="text-transform:
  uppercase">Date:</span></b>&nbsp;&nbsp;20071004</p> <p class="MsoNormal" style="margin-top:0cm;margin-right:0cm;margin-bottom:2.9pt;
  margin-left:31.5pt"><b><span style="text-transform:uppercase">Docket:</span></b>&nbsp;&nbsp;31227</p></td>
