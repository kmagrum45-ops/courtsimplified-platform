    <td width="296" valign="top" style="width:222.3pt;padding:2.9pt 2.9pt 2.9pt 2.9pt"><p class="MsoNormal"><b><span style="font-variant:small-caps">Appeal heard:</span></b> October&nbsp;7, 2015</p> <p class="MsoNormal"><b><span style="font-variant:small-caps">Judgment rendered:</span></b> July&nbsp;8, 2016</p> <p class="MsoNormal"><b><span style="font-variant:small-caps">Docket:</span></b> 36068</p></td>
   </tr>
  </tbody>
 </table>
 <p class="MsoNormal">&nbsp;</p>
