    <label for="decisia-date-to">and</label>
    <input id="decisia-date-to" class="date" type="date" name="d2" value="" />
</div>
        </div>
        <div id="decisia-date-from-error" class="decisia-date-from-error" role="status" aria-live="polite"></div>
    </div>
