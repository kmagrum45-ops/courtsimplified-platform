  | "charter"
  | "public-authority"
  | "strategy";

export type LitigationStrength = {
  id: string;
  title: string;
  explanation: string;
  linkedEvidenceLabels: string[];
};

export type LitigationWeakness = {
  id: string;
  category: LitigationIssueCategory;
  riskLevel: LitigationRiskLevel;
  title: string;
  explanation: string;
  suggestedFixes: string[];
  linkedEvidenceLabels: string[];
