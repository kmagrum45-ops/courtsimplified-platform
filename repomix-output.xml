    );
  }

  if (
    includesAny(lower, ["someone", "they", "he", "she", "them"]) &&
    !includesAny(lower, ["named", "called", "identified"])
  ) {
    findings.push(
      createFinding({
        category: "missing-party",
        severity: "medium",
        title: "Person or party is unclear",
        explanation:
