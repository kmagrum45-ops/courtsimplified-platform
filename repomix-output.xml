      lines = ($content -split "`n").Count
      imports = ([regex]::Matches($content, "from\s+['""][^'""]+['""]")).Value
      exports = ([regex]::Matches($content, "export\s+(type|function|const|class|interface)\s+[A-Za-z0-9_]+")).Value
