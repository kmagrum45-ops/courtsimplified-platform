        )
        .eq("court_type", path)
        .order("form_number", { ascending: true })
        .order("official_title", { ascending: true });

      if (error) {
        setLoadError(error.message);
        setForms([]);
        setLoading(false);
        return;
      }

      setForms(((data || []) as CleanFormItem[]).sort(sortByFormNumber));
      setLoading(false);
    }

    loadForms();
  }, [path]);

  useEffect(() => {
