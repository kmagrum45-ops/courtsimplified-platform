function buildEvidenceProfile(input: CivilWorkflowInput): CivilEvidenceProfile {
  const text = combinedText(input);
  const items = input.evidenceItems || [];

  return {
    evidenceItems: items,

    keyEvidenceStrengths: cleanStringList([
