    $_.FullName -notlike "*\.next\*" -and
    $_.FullName -notlike "*\.git\*" -and
    $_.FullName -notlike "*\_PROJECT_REGISTRY\*"
  }

$allFiles = Get-ChildItem -Recurse -File |
