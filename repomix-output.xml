      id: body.id || body.caseId || existing?.persistedRecord?.id || null,
      title:
        body.title ||
        existing?.persistedRecord?.title ||
        existing?.title ||
        "Untitled CourtSimplified case",
      casePath:
        body.casePath ||
        body.path ||
        existing?.persistedRecord?.casePath ||
