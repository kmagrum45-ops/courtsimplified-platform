  ];

  const workspaceHref = caseId ? `/dashboard/cases/${caseId}` : "/dashboard";

  const evidenceHref = buildWorkflowHref("/evidence", caseId, path);

  const formsHref = buildWorkflowHref("/forms", caseId, path);

