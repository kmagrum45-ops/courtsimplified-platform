    structuredCaseSummary: `Fallback analysis based on normalized intake. Raw issue signals: ${domains.join(", ")}. Raw text length: ${rawText.length}.`,
    nextBestActions: [
      "Confirm OpenAI configuration and rerun the analysis.",
