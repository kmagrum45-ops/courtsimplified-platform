  mayUseFor: ["may-use-for-guidance", "internal-only"],
  mustNotUseFor: [
    "Do not cite as law.",
    "Do not present as verified legal authority.",
  ],
  requiresVerificationBeforeCitation: true,
  requiresCurrentnessCheck: true,
