  | "corroborates"
  | "supports_same_issue"
  | "contradicts"
  | "same_event"
  | "duplicate_or_overlap"
  | "chronology_gap"
  | "credibility_concern"
  | "authenticity_concern"
  | "missing_damages_proof"
  | "missing_causation_proof"
  | "missing_foundation";

