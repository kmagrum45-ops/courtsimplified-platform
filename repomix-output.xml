          "Motion dismissed or adjourned",
          "Insufficient evidence",
          "Improper notice",
          "Costs risk",
        ],
        source: "proceduralStateSimulation.motion",
      }),
    );
  }

  if (simulatedState === "trial-preparation") {
    findings.push(
      createFinding({
        category: "trial-readiness",
        severity: "high",
        confidence: "medium",
        title: "Trial readiness must be assessed",
