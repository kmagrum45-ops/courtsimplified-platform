    async function saveMasterCase() {
      if (!analysis || !caseData) return;

      setSavingMaster(true);
      setSaveError("");

      const {
        data: { user },
      } = await supabase.auth.getUser();

      let finalCaseId = queryCaseId || masterCaseId || "";
      const stage = getStageForPersistence(analysis, caseData);
