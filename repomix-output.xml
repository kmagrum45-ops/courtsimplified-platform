          verification.verified,

        authorityWeight:
          weight.weightScore,

        requiresManualReview:
          verification.requiresManualReview,

        reasons,

        warnings: uniqueStrings([
          ...verification.warnings,
          ...weight.warnings,
        ]),

        recommendation:
          recommendationForResult({
            safetyLevel,
          }),
      };
    });

  return {
    results,

    safeAuthorityIds: results
      .filter(
        (result) =>
          result.safetyLevel === "safe",
      )
      .map(
        (result) =>
          result.authorityId,
      ),

    reviewAuthorityIds: results
      .filter(
        (result) =>
          result.safetyLevel ===
          "review-required",
      )
      .map(
        (result) =>
          result.authorityId,
      ),

    unsafeAuthorityIds: results
      .filter(
        (result) =>
          result.safetyLevel ===
          "unsafe",
      )
      .map(
        (result) =>
          result.authorityId,
      ),

    warnings: uniqueStrings(
      results.flatMap(
        (result) =>
          result.warnings,
      ),
    ),
  };
}



