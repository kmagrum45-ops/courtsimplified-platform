    ),
    credibilityConcerns: findingsByCategory(findings, "credibility-risk").map(
      (finding) => finding.recommendedQuestion,
    ),
    contradictionConcerns: findingsByCategory(findings, "contradiction-risk").map(
      (finding) => finding.recommendedQuestion,
    ),
