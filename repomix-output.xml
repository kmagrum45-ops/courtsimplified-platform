  credibilityAnalysis?: Record<string, unknown>;
  proofAnalysis?: Record<string, unknown>;
  settlementHistory?: SettlementInvestigationInput["settlementHistory"];
  trialMaterials?: TrialReadinessInput["trialMaterials"];
