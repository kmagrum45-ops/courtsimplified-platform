          "Verify source",
          "Verify jurisdiction",
          "Verify currency",
          "Verify issue fit",
        ],
        risksIfIgnored: [
          "Unsupported legal position",
          "Wrong authority",
          "Weak or unsafe generated materials",
        ],
        source: "authorityAnalysis.warnings",
      }),
    );
  }

  for (const id of analysis.unsafeAuthorityIds || []) {
    findings.push(
      createFinding({
