                  setIssues((current) => toggleArrayValue(current, option.value))
                }
                className={`rounded-2xl border px-4 py-3 text-left text-sm ${
                  issues.includes(option.value)
                    ? "border-[#2f7d67] bg-[#e9f7f2] text-[#16302b]"
