export type LitigationRiskLevel = "low" | "moderate" | "high";

export type LitigationIssueCategory =
  | "evidence"
  | "credibility"
  | "timeline"
  | "procedure"
  | "damages"
  | "causation"
  | "jurisdiction"
  | "limitation"
