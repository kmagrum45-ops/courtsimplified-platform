type LegacyCourtPath = "family" | "small-claims" | "civil" | "not-sure";

type EmotionalTone = "standard" | "supportive" | "urgent" | "simplified";

type ComplexityLevel =
  | "simple"
  | "moderate"
  | "complex"
  | "high-risk"
  | "not-sure";

type CourtSimplifiedAnalysis = {
  summary: string;
  plainLanguageSummary: string;
